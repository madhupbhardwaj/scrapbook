rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules, then click Publish.
//
// Anyone can read published content. Only people listed in the "admins" collection
// (document ID = their user UID) can change anything or see drafts.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subsections/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{id} {
      allow read: if isAdmin() || resource.data.draft == false;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != uid;
    }
  }
}
